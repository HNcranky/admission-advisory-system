@startuml seq_advisory_dispatch
skinparam shadowing false
skinparam defaultFontName Arial

actor Student as user
participant "Browser\n(chat UI)" as ui
participant "chat_api\n(FastAPI route)" as api
participant "Conversation\nService\n(turn graph)" as conv
participant "ChatSession\nRepository" as repo
queue "chat_advisory_runs\n(durable queue)" as queue
participant "RunQueueWorker\n(SKIP LOCKED)" as worker
participant "RunDispatcher\n→ advisory graph" as disp
database "PostgreSQL" as db
participant "Langfuse" as lf

user -> ui : type message
ui -> api : POST /api/sessions/{token}/messages
api -> conv : handle_user_message(token, content)
conv -> conv : turn graph:\nguards → intent_router → route
conv --> api : ConversationTurnResult\n(should_start_run=true)
api -> repo : enqueue_run(token, profile_state)
repo -> queue : INSERT chat_advisory_runs (queued)
api --> ui : 200 (ack, run queued)

worker -> queue : claim next queued\n(UPDATE ... FOR UPDATE SKIP LOCKED)
queue --> worker : claimed run
worker -> lf : advisory_run_trace ROOT span\n(trace id = derive(run_id))
worker -> disp : execute(run)
disp -> repo : mark_run_running(run_id)
disp -> disp : graph.invoke(AgentState)\nprofile → retrieve → conflict\n→ reason → policy → explain
disp -> lf : stage_span per node;\nrecord_generation per LLM call\n(model, prompt, tokens, attempt)
disp -> repo : complete_run(run_id, result)
disp -> repo : append_message(assistant,\nfinal_answer)
disp -> repo : update_session_status(completed)

loop until run completes
  ui -> api : GET /api/sessions/{token}
  api --> ui : messages
end
ui --> user : render answer
@enduml

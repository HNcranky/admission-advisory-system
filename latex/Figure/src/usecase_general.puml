@startuml usecase_general
!pragma layout smetana
left to right direction
skinparam actorStyle awesome
skinparam shadowing false
skinparam defaultFontName Arial

actor "Student" as student
actor "Operator" as operator

rectangle "Admission Advisory System" {
  usecase "Start anonymous\nchat session" as UC1
  usecase "Receive advisory\nrecommendation" as UC2
  usecase "Ask factual question\n(knowledge Q&A)" as UC3
  usecase "Compare schools\n(hybrid query)" as UC4
  usecase "Reset advisory\nprofile" as UC5
  usecase "Inspect advisory\ntrace panel" as UC6
  usecase "Run data ingestion\n(per school / source / URL)" as UC7
  usecase "Manage source\nregistry" as UC8
}

student --> UC1
student --> UC2
student --> UC3
student --> UC4
student --> UC5
operator --> UC6
operator --> UC7
operator --> UC8
@enduml

@startuml usecase_ingestion
!pragma layout smetana
left to right direction
skinparam actorStyle awesome
skinparam shadowing false
skinparam defaultFontName Arial

actor "Operator" as operator

rectangle "Data ingestion (CLI)" {
  usecase "List registered\nschools" as UC1
  usecase "Ingest all sources\nof a school" as UC2
  usecase "Ingest a single\nregistered source" as UC3
  usecase "Ingest an ad-hoc\nURL" as UC4
  usecase "Ingest knowledge\ndocuments (RAG corpus)" as UC5
  usecase "Persist normalized\nrecords to canonical store" as UC6
}

operator --> UC1
operator --> UC2
operator --> UC3
operator --> UC4
operator --> UC5
UC2 ..> UC6 : <<include>>
UC3 ..> UC6 : <<include>>
UC4 ..> UC6 : <<include>>
@enduml

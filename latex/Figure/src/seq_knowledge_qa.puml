@startuml seq_knowledge_qa
skinparam shadowing false
skinparam defaultFontName Arial

actor Student as user
participant "Conversation\nService" as conv
participant "KnowledgeQA\nService" as qa
participant "QACache\nRepository" as cache
participant "kqa subgraph\n(LangGraph)" as kqa
participant "GeminiEmbedder" as embed
participant "KnowledgeChunk\nRepository" as repo
database "PostgreSQL\n(pgvector)" as db
participant "Inference\nGateway" as gw

user -> conv : "Học phí UET bao nhiêu?"
conv -> qa : answer(question, school=VNU-UET,\ntopic=tuition)
qa -> cache : lookup(question embedding,\nschool, topic)
cache -> db : nearest cached answer within\nthreshold; scope version current?

alt semantic cache hit (fresh)
  db --> cache : matching, non-stale entry
  cache --> qa : CachedAnswer(from_cache=true)
  qa --> conv : KnowledgeQAResult(answer,\ncitations, from_cache)
  conv --> user : answer + cited sources
else miss or stale : run kqa subgraph
  db --> cache : none
  cache --> qa : miss
  qa -> kqa : invoke(KQAState)
  kqa -> embed : embed([question],\nRETRIEVAL_QUERY)
  embed --> kqa : query vector (768-d)
  kqa -> repo : vector_search(embedding,\nschool, topic, top_k)
  repo -> db : cosine search on\nknowledge_chunks (HNSW)
  db --> repo : scored chunks
  kqa -> repo : vector_search(school=MOET)\n(national augmentation)
  repo --> kqa : national chunks (own budget)

  alt top score < min_score
    kqa --> qa : has_data=false
    qa --> conv : KnowledgeQAResult(has_data=false)
    conv --> user : honest "no data" reply
  else grounded generation
    kqa -> gw : run(knowledge_qa, JSON mode,\nnumbered chunks + question)
    gw --> kqa : {"answer", "used_source_ids"}
    kqa -> kqa : resolve citations\n(dedupe by source URL)
    kqa --> qa : KnowledgeQAResult(answer,\ncitations, confidence)
    qa -> cache : store(answer, embedding,\nscope version stamp)
    qa --> conv : KnowledgeQAResult
    conv --> user : answer + cited sources
  end
end
@enduml

@startuml usecase_knowledge
!pragma layout smetana
left to right direction
skinparam actorStyle awesome
skinparam shadowing false
skinparam defaultFontName Arial

actor "Student" as student

rectangle "Knowledge Q&A and hybrid comparison" {
  usecase "Ask school- or\ntopic-scoped question" as UC1
  usecase "Receive grounded answer\nwith source citations" as UC2
  usecase "Receive honest\n'no data' reply" as UC3
  usecase "Compare schools on\nfacts and cutoffs" as UC4
  usecase "Receive synthesized\ncomparison" as UC5
}

student --> UC1
student --> UC4
UC1 ..> UC2 : <<include>>
UC2 <.. UC3 : <<extend>>\n(low retrieval\nconfidence)
UC4 ..> UC5 : <<include>>
@enduml

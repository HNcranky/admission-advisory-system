@startuml package_overview
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam ranksep 40
skinparam nodesep 30

package "web" as web {
  package "routes" as routes {}
  package "templates / static" as tmpl {}
}

package "services" as services {
  package "chat" as chat {}
  package "knowledge" as knowledge {}
  package "tracing" as tracing {}
  package "inference" as inference {}
  package "conflict" as conflict {}
  package "cutoff" as cutoff {}
  package "profile" as profile {}
}

package "advisory pipeline" as pipeline {
  package "graph.py + state.py" as graphpkg {}
  package "agents" as agents {}
}

package "ingestion" as ingestion {
  package "fetchers / parsers / extractors" as fpe {}
  package "normalization" as norm {}
  package "pipeline + storage.db_writer" as ingpipe {}
  package "knowledge corpus" as ingknow {}
}

package "domain" as domain {
  package "models.py (shared)" as dmodels {}
}

package "observability" as obs {
  package "langfuse_client / run_trace" as lf {}
  package "prompts (PromptService)" as prompts {}
}

package "PostgreSQL 16 + pgvector" as db {}
package "Langfuse (self-hosted)" as langfuse {}

routes --> chat
chat --> knowledge
chat --> inference
chat --> profile
chat --> graphpkg
graphpkg --> agents
agents --> conflict
agents --> cutoff
agents --> inference
knowledge --> inference
conflict --> inference
chat --> tracing
tracing --> obs
inference --> obs
chat --> obs
obs --> langfuse
chat --> db
knowledge --> db
agents --> db
ingpipe --> db
fpe --> ingpipe
norm --> ingpipe
ingknow --> db
inference ..> dmodels
agents ..> dmodels
@enduml

# Copy this file to .env and fill in values.

# Gemini API key(s). Comma-separate extras for key rotation.
GEMINI_API_KEY=your-api-key-here
# GEMINI_API_KEYS=key1,key2,key3

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=admission
DB_USER=postgres
DB_PASSWORD=postgres

# Connection pool (psycopg2 ThreadedConnectionPool). Set to false for emergency rollback.
DB_POOL_ENABLED=true
DB_POOL_MIN=1
DB_POOL_MAX=10

# Embedding cache (set 0 to disable)
EMBED_CACHE_SIZE=512

# --- Runtime model tiers (advisory/chat) ---
# Two tiers cover every agent in services/inference/factory.py. Unset = the
# proven gemini-2.5 defaults. Override to move the whole runtime to another tier
# (e.g. gemini-3.x). Validate any swap with the eval/knowledge_qa harness first.
# STRONG = reasoning-heavy agents (knowledge QA, follow-up, synthesis, fact
# extraction, OCR fallback); LITE = cheap default + graceful-degradation fallback.
# ADVISORY_MODEL_STRONG=gemini-3.5-flash
# ADVISORY_MODEL_LITE=gemini-3.1-flash-lite
# Ingestion side (separate knobs, already env-driven):
# GEMINI_EXTRACTION_MODEL=gemini-2.5-flash
# GEMINI_OCR_MODEL=gemini-2.5-flash-lite

# Advisory dispatcher
ADVISORY_RUN_WORKERS=2
ADVISORY_RUN_QUEUE_MAX=32

# Web threadpool
WEB_THREADPOOL_SIZE=40

# Durable queue (requires migration 018). Default on after PR9.
ADVISORY_DURABLE_QUEUE=false
ADVISORY_QUEUE_POLL_SECONDS=1.0

# --- Observability (Langfuse) ---
# Master switch. When false (default) all Langfuse instrumentation is a no-op.
ADVISORY_LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional: separates traces in the Langfuse project (e.g. development|production)
# and tags the deployed version. Default environment is "development".
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=
# --- Langfuse prompt management ---
# Label fetched at runtime (move it in the UI to deploy/rollback). Dev can set
# "latest" to pick up edits immediately.
LANGFUSE_PROMPT_LABEL=production
# In-process cache TTL for fetched prompts (seconds). The SDK refreshes in the
# background; the in-code fallback covers any fetch failure.
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=300

# Copy to .env.langfuse and fill with generated secrets (see QUICKSTART).
# Used only by docker-compose.langfuse.yml — NOT by the app.
#
# Variable names MUST match what docker-compose.langfuse.yml reads.
# Security-sensitive secrets (generate each: openssl rand -hex 32):
SALT=
ENCRYPTION_KEY=          # must be exactly 64 hex chars
NEXTAUTH_SECRET=

# Internal infra creds (compose network only).
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=

# Must embed the SAME POSTGRES_PASSWORD value, or langfuse-web/worker fail auth
# with Prisma P1000. Hex passwords need no URL-encoding.
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/postgres
